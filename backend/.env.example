# Local backend execution (PostgreSQL exposed by Docker on localhost).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://fqa_user:replace-with-a-strong-password@localhost:5433/fqa_empleos?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@fqa.local
RESET_PASSWORD_URL=http://localhost:5173/reset-password
MAIL_OUTBOX_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS

# Dedicated database, created separately; its name must end in _test.
TEST_DATABASE_URL=postgresql://fqa_user:replace-with-a-strong-password@localhost:5433/fqa_empleos_test?schema=public

# Private CV storage for direct local development; production must select its provider.
RESUME_STORAGE_DRIVER=filesystem
RESUME_STORAGE_DIRECTORY=./private/resumes

# Development only. Requires PostgreSQL 17 clients and a separate persistent secret.
BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./private/backups
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_64_HEXADECIMAL_BACKUP_KEY

# Private temporary Excel exports; ready files expire after 24 hours.
STATISTICS_EXPORT_DIRECTORY=./private/statistics-exports
