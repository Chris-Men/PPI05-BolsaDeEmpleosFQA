# Local backend execution (PostgreSQL exposed by Docker on localhost).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://fqa_user:replace-with-a-strong-password@localhost:5432/fqa_empleos?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Dedicated database, created separately; its name must end in _test.
TEST_DATABASE_URL=postgresql://fqa_user:replace-with-a-strong-password@localhost:5432/fqa_empleos_test?schema=public
