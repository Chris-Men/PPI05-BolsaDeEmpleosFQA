# Shared
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://fqa_user:replace-with-a-strong-password@postgres:5432/fqa_empleos?schema=public

# PostgreSQL
POSTGRES_DB=fqa_empleos
POSTGRES_USER=fqa_user
POSTGRES_PASSWORD=replace-with-a-strong-password

# Production proxy
DOMAIN=empleos.example.com
GHCR_OWNER=replace-with-github-owner
IMAGE_TAG=latest