# Copy this file to .env in the repository root before using Docker Compose.
# Replace every REPLACE_* value. Never commit the resulting .env file.

# Development frontend
VITE_API_URL=http://localhost:3000/api

# Development backend
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://fqa_user:REPLACE_WITH_THE_DATABASE_PASSWORD@postgres:5432/fqa_empleos?schema=public

# PostgreSQL. The password must match the value encoded in DATABASE_URL.
POSTGRES_DB=fqa_empleos
POSTGRES_USER=fqa_user
POSTGRES_PASSWORD=REPLACE_WITH_THE_DATABASE_PASSWORD

# Production only. See docs/SETUP.md before using docker-compose.yml.
DOMAIN=empleos.example.com
GHCR_OWNER=REPLACE_WITH_GITHUB_OWNER
IMAGE_TAG=latest